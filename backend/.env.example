# ============================================================
# Hospital Operations Backend — Environment Variables
# ============================================================
# Copy this file to .env and edit the values as needed.
#   cp .env.example .env
# ============================================================

APP_NAME="Hospital Operations & Workflow Optimization"
APP_VERSION="0.1.0"
DEBUG=True

# SQLite (default for development)
DATABASE_URL="sqlite:///./hospital_ops.db"

# PostgreSQL (uncomment for production)
# DATABASE_URL="postgresql://user:password@localhost:5432/hospital_ops"

# Comma-separated list of allowed CORS origins
CORS_ORIGINS="http://localhost:5173"
